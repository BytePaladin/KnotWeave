<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121216">

    <!-- The Graph Rendering View -->
    <com.knotweave.sdk.DeadlockCanvasView
        android:id="@+id/deadlockCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="250dp" />

    <!-- Floating Toast Notification Banner -->
    <LinearLayout
        android:id="@+id/toastBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="270dp"
        android:background="#E61E293B"
        android:elevation="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtToastMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Glassmorphic Bottom Control Panel -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="20dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="250dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Top Drag Bar Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#44FFFFFF" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header with App Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#00000000"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/app_logo" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KnotWeave"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interactive Resource Allocation Graph"
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Graph Generation Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Graph Generation"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="#22FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="Processes"
                        android:textColorHint="#99FFFFFF"
                        app:hintTextColor="#D0BCFF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputGenP"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:hint="Resources"
                        android:textColorHint="#99FFFFFF"
                        app:hintTextColor="#D0BCFF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputGenR"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:hint="Instances/Res"
                        android:textColorHint="#99FFFFFF"
                        app:hintTextColor="#D0BCFF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputGenI"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoGenerateBatch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:text="Auto Generate Batch"
                    android:textColor="#381E72"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#D0BCFF"
                    app:cornerRadius="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddProcess"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="+ 1 Process"
                        android:textColor="#381E72"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#D0BCFF"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddResource"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="+ 1 Resource"
                        android:textColor="#381E72"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#D0BCFF"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForceDeadlock"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Force Deadlock"
                        android:textColor="#1E293B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F59E0B"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Clear"
                        android:textColor="#601410"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F2B8B5"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Contextual Selection Properties Panel -->
                <LinearLayout
                    android:id="@+id/propertiesPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#15FFFFFF"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="Selection Properties"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteSelection"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:text="Delete"
                            android:textColor="#601410"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#F2B8B5"
                            app:cornerRadius="8dp" />
                    </RelativeLayout>

                    <!-- Edge selected section -->
                    <LinearLayout
                        android:id="@+id/edgePropertiesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtEdgeInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Line / Connection Selected."
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemoveSelectedLine"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="Remove Selected Line"
                            android:textColor="#601410"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#F2B8B5"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- Node Properties container -->
                    <LinearLayout
                        android:id="@+id/nodePropertiesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Label"
                            android:textColorHint="#99FFFFFF"
                            app:hintTextColor="#D0BCFF">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/dynamicResourceContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:id="@+id/dynamicMaxNeedContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Simulation Status Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Simulation Status"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="#22FFFFFF" />

                <LinearLayout
                    android:id="@+id/statusBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="#3310B981"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtDeadlockStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO DEADLOCK"
                        android:textColor="#6EE7B7"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/safeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="#3338BDF8"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtSafeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State: SAFE (Banker's)"
                        android:textColor="#7DDBFC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSafeSequence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Safe Sequence: None"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoResolve"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Auto Resolve (Kill Victim)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="#E11D48"
                    app:cornerRadius="10dp" />

                <!-- Instructions Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Instructions"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="#22FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="• Drag from an Out port circle to an In port circle to connect nodes.\n• Process (Out) ➔ Resource (In): Request\n• Resource (Out) ➔ Process (In): Allocation\n• Tap an edge or node to view &amp; delete it."
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
